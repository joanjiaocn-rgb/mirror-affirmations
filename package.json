{
  "name": "mirror-affirmations",
  "version": "0.1.0",
  "description": "Mirror Affirmations: a private no-recording mirror practice for gentle self-talk.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mirror affirmations",
    "selfie affirmations",
    "positive self talk",
    "bedtime affirmations"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20260722.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
